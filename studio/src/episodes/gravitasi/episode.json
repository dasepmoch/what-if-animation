 "script": [
  {
   "beat": "1 cold open: demo 1 (small, selfish) - kitchen",
   "text": "Toples kue di rak paling atas. Lompat. Dapat."
  },
  {
   "beat": "1 cold open: demo 2 (useful) - stairwell",
   "text": "Telat masuk kelas. Tangga dua lantai. Lompat. Lompat. Sampai duluan."
  },
  {
   "beat": "1 cold open: demo 3 (uncanny) - rooftop",
   "text": "Atap ke atap. Lompat. Tapi kamu nggak turun-turun."
  },
  {
   "beat": "2 premise + rule (title card)",
   "text": "Gimana kalau gravitasimu tinggal sepuluh persen? Cuma kamu. Dunia tetap normal."
  },
  {
   "beat": "3 the fun part (numbers, class, bed)",
   "text": "Berat badanmu lima puluh kilo. Sekarang terasa cuma lima. Lompatan biasa setengah meter. Sekarang lima meter. Enam detik melayang di udara. Pelajaran olahraga? Kamu juara kelas. Temanmu cuma bisa melongo. Mau tidur? Kamu mengambang di atas kasur."
  },
  {
   "beat": "4 the turn: the cost, one real fact",
   "text": "Tapi tubuhmu punya aturan sendiri. Tulang cuma kuat kalau diberi beban. Astronaut di luar angkasa kehilangan satu sampai satu setengah persen kepadatan tulang. Setiap bulan. Itu nyata. Dan bebanmu sekarang tinggal sepersepuluh. Tubuhmu nggak tahu ini kekuatan super. Yang dia tahu, bebannya hilang."
  },
  {
   "beat": "4b the consequence on screen",
   "text": "Minggu ketiga. Pendaratan biasa. Krek. Bukan lantainya yang retak."
  },
  {
   "beat": "5 someone powerful notices",
   "text": "Temanmu merekam satu lompatanmu. Ditonton sejuta kali dalam semalam. Besoknya, ada yang mengetuk pintu. Pria berjas. Dia tahu namamu. Dia tahu angkamu. Dia nggak datang untuk menolong. Dia datang untuk mengukur."
  },
  {
   "beat": "6 family at stake: little sister",
   "text": "Sore itu, adikmu ikut ke atap. Angin bertiup kencang. Kakimu terangkat dari lantai. Cuma tangan kecilnya yang menahanmu."
  },
  {
   "beat": "7 cliffhanger",
   "text": "Lalu angka itu turun lagi. Sembilan persen. Delapan. Berapa lama sampai kamu nggak bisa turun lagi?"
  }
 ],
 "science": [
  {
   "claim": "Astronaut kehilangan 1 sampai 1,5 persen kepadatan tulang setiap bulan di luar angkasa.",
   "working": "NASA Human Research Program: on average, bones lose between 1% and 1.5% of their density each month during four-to-six-month missions. The script states the astronaut figure only; it does not claim the same rate at 10% gravity.",
